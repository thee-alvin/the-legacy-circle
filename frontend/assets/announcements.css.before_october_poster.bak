
:root {
    --navy-950: #071a2e;
    --navy-900: #0b2746;
    --navy-800: #12385f;
    --gold: #d4af37;
    --gold-soft: rgba(212,175,55,.12);
    --muted: #647891;
    --border: #dce4ed;
    --page: #f3f6fa;
    --card: #ffffff;
    --danger: #a33227;
}

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    min-height: 100%;
}

body {
    min-height: 100vh;
    background:
        linear-gradient(
            180deg,
            #eef3f8 0%,
            var(--page) 100%
        );
    color: var(--navy-900);
    font-family:
        Arial,
        Helvetica,
        sans-serif;
}

button,
a {
    font: inherit;
}

.hidden {
    display: none !important;
}


/* PAGE */

.announcements-page {
    min-height: 100vh;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 34px 0 18px;

    display: flex;
    flex-direction: column;
}


/* HEADER */

.announcements-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 28px;
    margin-bottom: 28px;
}

.page-kicker,
.section-kicker {
    color: var(--gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.announcements-header h1 {
    margin: 7px 0 8px;
    font-size: 38px;
    line-height: 1.05;
    letter-spacing: -.02em;
}

.announcements-header p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
}

.heading-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.header-button,
.back-link {
    min-height: 46px;
    padding: 0 19px;
    border-radius: 10px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
}

.header-button {
    border: 1px solid var(--gold);
    background: var(--gold);
    color: var(--navy-900);
    cursor: pointer;
}

.back-link {
    border: 1px solid var(--border);
    background: #ffffff;
    color: var(--navy-900);
}


/* STATES */

.state-card {
    min-height: 68px;
    padding: 18px 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;

    color: var(--muted);
    font-size: 13px;
}

.loading-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--gold);
}

.error-state {
    border-color: #e8b6b0;
    background: #fff7f6;
    color: var(--danger);
}


/* SUMMARY */

.summary-grid {
    display: grid;
    grid-template-columns:
        repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 22px;
}

.summary-card {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 15px;

    padding: 21px;

    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 15px;

    box-shadow:
        0 8px 24px rgba(11,39,70,.05);
}

.summary-icon {
    width: 46px;
    height: 46px;
    flex: 0 0 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;
    background: var(--gold-soft);
    border: 1px solid rgba(212,175,55,.35);

    color: var(--navy-900);
    font-size: 13px;
    font-weight: 900;
}

.summary-label {
    display: block;
    color: var(--muted);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .08em;
}

.summary-card strong {
    display: block;
    margin: 5px 0 2px;

    color: var(--navy-900);
    font-size: 26px;
    line-height: 1;
}

.summary-note {
    color: var(--muted);
    font-size: 11px;
}


/* SECTION */

.section-card {
    overflow: hidden;

    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 17px;

    box-shadow:
        0 10px 28px rgba(11,39,70,.06);
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 25px;

    padding: 23px 25px 20px;

    border-bottom: 1px solid var(--border);
}

.section-header h2 {
    margin: 6px 0 4px;
    font-size: 22px;
}

.section-description {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
}

.record-count {
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
}


/* ANNOUNCEMENTS */

.announcements-list {
    display: grid;
    gap: 14px;
    padding: 20px;
}

.announcement-card {
    padding: 20px;

    border: 1px solid var(--border);
    border-radius: 14px;

    background: #fbfcfe;

    transition:
        border-color .2s ease,
        box-shadow .2s ease;
}

.announcement-card:hover {
    border-color: rgba(212,175,55,.55);
    box-shadow:
        0 6px 18px rgba(11,39,70,.06);
}

.announcement-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
}

.announcement-title {
    margin: 0;
    color: var(--navy-900);
    font-size: 18px;
    line-height: 1.35;
}

.announcement-message {
    margin: 14px 0 18px;
    color: #30445b;
    font-size: 13px;
    line-height: 1.7;
    white-space: pre-line;
}

.announcement-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.announcement-badge {
    min-height: 27px;
    padding: 0 9px;

    display: inline-flex;
    align-items: center;

    border-radius: 999px;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: .03em;
}

.badge-type {
    background: rgba(11,39,70,.08);
    border: 1px solid rgba(11,39,70,.14);
    color: var(--navy-900);
}

.badge-priority {
    background: var(--gold-soft);
    border: 1px solid rgba(212,175,55,.35);
    color: var(--navy-900);
}

.announcement-info {
    margin-top: 13px;
    padding-top: 12px;

    display: flex;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;

    border-top: 1px solid var(--border);

    color: var(--muted);
    font-size: 11px;
}


/* EMPTY */

.empty-state {
    padding: 65px 24px;
    text-align: center;
}

.empty-icon {
    width: 54px;
    height: 54px;

    margin: 0 auto 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;
    background: var(--gold-soft);
    color: var(--navy-900);
    font-weight: 900;
}

.empty-state h3 {
    margin: 0 0 7px;
    font-size: 17px;
}

.empty-state p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
}


/* FOOTER */

.page-footer {
    margin-top: auto;
    padding-top: 28px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 16px;
    flex-wrap: wrap;

    color: var(--muted);
    font-size: 11px;
}


/* RESPONSIVE */

@media (max-width: 900px) {

    .summary-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 760px) {

    .announcements-page {
        width: min(100% - 24px, 1180px);
        padding-top: 22px;
    }

    .announcements-header {
        flex-direction: column;
    }

    .heading-actions {
        width: 100%;
    }

    .header-button,
    .back-link {
        flex: 1;
    }

    .section-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .announcement-top {
        flex-direction: column;
    }

    .page-footer {
        flex-direction: column;
        align-items: flex-start;
    }
}
