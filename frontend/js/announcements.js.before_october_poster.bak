
let announcementsCache = [];


function escapeHtml(value) {

    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


function setText(id, value, fallback = "?") {

    const element =
        document.getElementById(id);

    if (!element) {
        return;
    }

    const text =
        String(value ?? "").trim();

    element.textContent =
        text || fallback;
}


function renderAnnouncements(records) {

    announcementsCache =
        Array.isArray(records)
            ? records
            : [];

    const list =
        document.getElementById(
            "announcementsList"
        );

    const empty =
        document.getElementById(
            "announcementsEmpty"
        );

    const count =
        document.getElementById(
            "announcementRecordCount"
        );

    if (!list) {
        return;
    }

    list.innerHTML = "";

    if (count) {
        count.textContent =
            `${records.length} announcement${
                records.length === 1
                    ? ""
                    : "s"
            }`;
    }

    if (records.length === 0) {

        list.classList.add("hidden");

        if (empty) {
            empty.classList.remove("hidden");
        }

        return;
    }

    if (empty) {
        empty.classList.add("hidden");
    }

    list.classList.remove("hidden");

    records.forEach(item => {

        const card =
            document.createElement("article");

        card.className =
            "announcement-card";

        const type =
            item["Announcement Type"] || "GENERAL";

        const priority =
            item["Priority"] || "NORMAL";

        const title =
            item["Title"] || "Untitled Announcement";

        const message =
            item["Message"] || "No message provided.";

        const date =
            item["Announcement Date"] || "?";

        const postedBy =
            item["Posted By"] || "TLC";

        const expiry =
            item["Expiry Date"] || "";

        card.innerHTML = `
            <div class="announcement-top">

                <div>
                    <h3 class="announcement-title">
                        ${escapeHtml(title)}
                    </h3>
                </div>

                <div class="announcement-meta">

                    <span class="announcement-badge badge-type">
                        ${escapeHtml(type)}
                    </span>

                    <span class="announcement-badge badge-priority">
                        ${escapeHtml(priority)}
                    </span>

                </div>

            </div>

            <div class="announcement-message">
                ${escapeHtml(message)}
            </div>

            <div class="announcement-info">

                <span>
                    Published: ${escapeHtml(date)}
                </span>

                <span>
                    Posted by: ${escapeHtml(postedBy)}
                </span>

                ${
                    expiry
                        ? `<span>
                               Expires: ${escapeHtml(expiry)}
                           </span>`
                        : ""
                }

            </div>
        `;

        list.appendChild(card);
    });
}


function updateSummary(records) {

    setText(
        "totalAnnouncements",
        records.length,
        "0"
    );

    const newest =
        records.length > 0
            ? records[0]["Announcement Date"]
            : "None";

    setText(
        "newestAnnouncement",
        newest,
        "None"
    );

    const highPriority =
        records.filter(item => {

            const priority =
                String(
                    item["Priority"] || ""
                )
                .trim()
                .toUpperCase();

            return (
                priority === "HIGH" ||
                priority === "URGENT"
            );

        }).length;

    setText(
        "highPriorityAnnouncements",
        highPriority,
        "0"
    );
}


async function loadAnnouncements() {

    const loading =
        document.getElementById(
            "loadingState"
        );

    const error =
        document.getElementById(
            "errorState"
        );

    const content =
        document.getElementById(
            "mainContent"
        );

    if (loading) {
        loading.classList.remove(
            "hidden"
        );
    }

    if (error) {
        error.classList.add(
            "hidden"
        );
    }

    if (content) {
        content.classList.add(
            "hidden"
        );
    }

    try {

        const response =
            await fetch(
                "/api/member/announcements",
                {
                    method: "GET",
                    credentials: "same-origin",
                    headers: {
                        "Accept":
                            "application/json"
                    }
                }
            );

        const data =
            await response.json();

        if (
            !response.ok ||
            !data.success
        ) {
            throw new Error(
                data.message ||
                "Unable to load announcements."
            );
        }

        const records =
            Array.isArray(
                data.announcements
            )
                ? data.announcements
                : [];

        renderAnnouncements(records);
        updateSummary(records);

        if (loading) {
            loading.classList.add(
                "hidden"
            );
        }

        if (content) {
            content.classList.remove(
                "hidden"
            );
        }

    } catch (errorMessage) {

        console.error(
            "Announcements loading error:",
            errorMessage
        );

        if (loading) {
            loading.classList.add(
                "hidden"
            );
        }

        if (error) {
            error.classList.remove(
                "hidden"
            );
        }
    }
}


document.addEventListener(
    "DOMContentLoaded",
    () => {

        const refresh =
            document.getElementById(
                "refreshAnnouncements"
            );

        if (refresh) {
            refresh.addEventListener(
                "click",
                loadAnnouncements
            );
        }

        loadAnnouncements();
    }
);
