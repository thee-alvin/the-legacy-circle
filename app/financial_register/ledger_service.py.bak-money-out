from pathlib import Path
from datetime import datetime, date

from openpyxl import load_workbook


BASE_DIR = Path(__file__).resolve().parents[2]

MEMBERS_FILE = (
    BASE_DIR
    / "data"
    / "spreadsheets"
    / "01_MEMBERS.xlsx"
)

CONTRIBUTIONS_FILE = (
    BASE_DIR
    / "data"
    / "spreadsheets"
    / "02_CONTRIBUTIONS.xlsx"
)

EXCLUDED_STATUSES = {
    "CANCELLED",
    "REJECTED",
}


def _clean(value):
    if value is None:
        return ""

    return str(value).strip()


def _amount(value):
    try:
        return float(value or 0)
    except (TypeError, ValueError):
        return 0.0


def _format_date(value):
    if isinstance(value, datetime):
        return value.strftime("%Y-%m-%d")

    if isinstance(value, date):
        return value.strftime("%Y-%m-%d")

    text = _clean(value)

    if not text:
        return ""

    try:
        return datetime.fromisoformat(
            text.replace("Z", "+00:00")
        ).strftime("%Y-%m-%d")
    except ValueError:
        pass

    if " " in text:
        return text.split(" ", 1)[0]

    return text


def _format_time(value):
    if isinstance(value, datetime):
        return value.strftime("%H:%M:%S")

    if hasattr(value, "strftime"):
        try:
            return value.strftime("%H:%M:%S")
        except Exception:
            pass

    return _clean(value)


def _load_members():
    workbook = load_workbook(
        MEMBERS_FILE,
        read_only=True,
        data_only=True,
    )

    try:
        sheet = workbook["Members"]

        rows = sheet.iter_rows(values_only=True)
        headers = next(rows, None)

        if not headers:
            return {}

        headers = [
            _clean(value)
            for value in headers
        ]

        member_id_index = headers.index(
            "Member ID"
        )

        name_index = headers.index(
            "Full Name"
        )

        members = {}

        for row in rows:

            member_id = _clean(
                row[member_id_index]
                if member_id_index < len(row)
                else ""
            ).upper()

            if not member_id:
                continue

            if member_id.startswith("TLC/TEST/"):
                continue

            name = _clean(
                row[name_index]
                if name_index < len(row)
                else ""
            )

            members[member_id] = {
                "member_id": member_id,
                "full_name": name or member_id,
            }

        return members

    finally:
        workbook.close()


def _load_transactions():
    workbook = load_workbook(
        CONTRIBUTIONS_FILE,
        read_only=True,
        data_only=True,
    )

    try:
        sheet = workbook["Contributions"]

        rows = sheet.iter_rows(values_only=True)
        headers = next(rows, None)

        if not headers:
            return []

        headers = [
            _clean(value)
            for value in headers
        ]

        records = []

        for row in rows:

            if not any(
                value is not None
                for value in row
            ):
                continue

            records.append(
                dict(zip(headers, row))
            )

        return records

    finally:
        workbook.close()


def _matches_period(
    payment_date,
    year=None,
    month=None,
):
    if not payment_date:
        return False

    if year:
        if not payment_date.startswith(
            f"{year}-"
        ):
            return False

    if month:
        month_text = f"{int(month):02d}"

        if not payment_date.startswith(
            f"{year}-{month_text}"
        ):
            return False

    return True


def build_financial_ledger(
    year=None,
    month=None,
):
    if month and not year:
        raise ValueError(
            "A month requires a year."
        )

    members = _load_members()
    records = _load_transactions()

    ledger = {}

    for member_id, member in members.items():

        ledger[member_id] = {
            "member_id": member_id,
            "full_name": member["full_name"],

            "registration_fees": 0.0,
            "weekly_contributions": 0.0,
            "total_contributions": 0.0,
            "fines": 0.0,

            "transaction_count": 0,

            "transactions": [],
        }

    for record in records:

        status = _clean(
            record.get("Status")
        ).upper()

        if status in EXCLUDED_STATUSES:
            continue

        payment_date = _format_date(
            record.get("Payment Date")
        )

        if year or month:

            if not _matches_period(
                payment_date,
                year,
                month,
            ):
                continue

        member_id = _clean(
            record.get("Member ID")
        ).upper()

        if not member_id:
            continue

        if member_id.startswith("TLC/TEST/"):
            continue

        if member_id not in ledger:

            ledger[member_id] = {
                "member_id": member_id,

                "full_name": (
                    _clean(
                        record.get(
                            "Full Name"
                        )
                    )
                    or member_id
                ),

                "registration_fees": 0.0,
                "weekly_contributions": 0.0,
                "total_contributions": 0.0,
                "fines": 0.0,

                "transaction_count": 0,

                "transactions": [],
            }

        member = ledger[member_id]

        amount = _amount(
            record.get("Amount")
        )

        payment_type = _clean(
            record.get("Payment Type")
        ).upper()

        transaction = {
            "date": payment_date,

            "time": _format_time(
                record.get(
                    "Payment Time"
                )
            ),

            "payment_type": payment_type,

            "amount": amount,

            "receipt_number": _clean(record.get("Receipt Number")),
        }

        member["transactions"].append(
            transaction
        )

        member["transaction_count"] += 1

        if payment_type == "REGISTRATION FEE":

            member["registration_fees"] += amount

        elif payment_type == "WEEKLY CONTRIBUTION":

            member["weekly_contributions"] += amount

        elif payment_type == "FINE":

            member["fines"] += amount

    members_list = list(
        ledger.values()
    )

    for member in members_list:

        member["total_contributions"] = (
            member["registration_fees"]
            + member["weekly_contributions"]
        )

        member["transactions"].sort(
            key=lambda item: (
                item["date"],
                item["time"],
            ),
            reverse=True,
        )

    def member_id_number(member):
        member_id = str(
            member.get("member_id", "")
        ).strip().upper()

        parts = member_id.split("/")

        if (
            len(parts) == 3
            and parts[0] == "TLC"
            and parts[1].isdigit()
            and parts[2].isdigit()
        ):
            try:
                return int(parts[1])
            except ValueError:
                pass

        return 999999999

    members_list.sort(
        key=lambda member: (
            member_id_number(member),
            member.get("member_id", ""),
        )
    )

    summary = {
        "members": len(members_list),

        "members_with_transactions": sum(
            1
            for member in members_list
            if member["transaction_count"] > 0
        ),

        "registration_fees": sum(
            member["registration_fees"]
            for member in members_list
        ),

        "weekly_contributions": sum(
            member["weekly_contributions"]
            for member in members_list
        ),

        "total_contributions": sum(
            member["total_contributions"]
            for member in members_list
        ),

        "fines": sum(
            member["fines"]
            for member in members_list
        ),

        "transactions": sum(
            member["transaction_count"]
            for member in members_list
        ),
    }

    summary["total_funds"] = (
        summary["total_contributions"]
        + summary["fines"]
    )

    if month and year:

        period_label = datetime(
            int(year),
            int(month),
            1,
        ).strftime("%B %Y")

    elif year:

        period_label = f"Year {year}"

    else:

        period_label = "All Recorded Transactions"

    return {
        "period": {
            "year": str(year)
            if year
            else None,

            "month": (
                f"{int(month):02d}"
                if month
                else None
            ),

            "label": period_label,
        },

        "generated_at": datetime.now().isoformat(
            timespec="seconds"
        ),

        "summary": summary,

        "members": members_list,
    }






