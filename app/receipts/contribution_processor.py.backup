from pathlib import Path
from datetime import datetime

from openpyxl import load_workbook

from app.receipts.receipt_number import format_receipt_number

from app.receipts.receipt_storage import (
    get_member_details,
    load_receipts,
    add_receipt,
)

from app.receipts.receipt_generator import create_receipt

from app.receipts.receipt_pdf_generator import (
    generate_receipt_pdf
)

from app.services.email_service import (
    send_receipt_email
)

from app.security.audit_log import record_activity

from app.receipts.contribution_process_lock import (
    process_lock
)


BASE_DIR = Path(__file__).resolve().parents[2]

CONTRIBUTIONS_FILE = (
    BASE_DIR
    / "data"
    / "spreadsheets"
    / "02_CONTRIBUTIONS.xlsx"
)


def get_next_receipt_number():

    receipts = load_receipts()

    current_year = datetime.now().year

    highest_sequence = 0

    for receipt in receipts:

        number = str(
            receipt.get("receipt_number", "")
        ).strip()

        parts = number.split("/")

        if len(parts) != 4:
            continue

        if parts[0] != "TLC":
            continue

        if parts[1] != "RCPT":
            continue

        if parts[2] != str(current_year):
            continue

        try:
            sequence = int(parts[3])
        except ValueError:
            continue

        highest_sequence = max(
            highest_sequence,
            sequence
        )

    return format_receipt_number(
        highest_sequence + 1,
        current_year
    )


def get_next_contribution_id(ws):

    highest = 0

    for row in range(2, ws.max_row + 1):

        value = ws.cell(
            row=row,
            column=1
        ).value

        if not value:
            continue

        text = str(value).strip().upper()

        if not text.startswith("TLC-CON-"):
            continue

        try:
            number = int(
                text.split("-")[-1]
            )
        except ValueError:
            continue

        highest = max(
            highest,
            number
        )

    return f"TLC-CON-{highest + 1:06d}"


def process_pending_contributions():

    """
    Process ONLY spreadsheet rows explicitly marked PENDING.

    A system-wide Windows lock prevents multiple TLC
    processes from processing the same contribution simultaneously.

    The row is changed to PROCESSING and saved BEFORE
    receipt/PDF/email work begins.
    """

    lock = process_lock()

    if not lock.acquire():

        return []

    try:

        if not CONTRIBUTIONS_FILE.exists():

            raise FileNotFoundError(
                f"Missing contributions workbook: "
                f"{CONTRIBUTIONS_FILE}"
            )

        workbook = load_workbook(
            CONTRIBUTIONS_FILE
        )

        if "Contributions" not in workbook.sheetnames:

            raise ValueError(
                "Contributions sheet was not found."
            )

        ws = workbook["Contributions"]

        headers = [
            str(cell.value).strip()
            if cell.value is not None
            else ""
            for cell in ws[1]
        ]

        required_headers = [
            "Contribution ID",
            "Receipt Number",
            "Member ID",
            "Full Name",
            "Phone Number",
            "Email",
            "Payment Date",
            "Payment Time",
            "Payment Type",
            "Description",
            "Amount",
            "Payment Method",
            "Transaction Reference",
            "Status",
            "Recorded By",
            "Created At",
        ]

        missing = [
            header
            for header in required_headers
            if header not in headers
        ]

        if missing:

            raise ValueError(
                "Missing spreadsheet columns: "
                + ", ".join(missing)
            )

        columns = {
            header: headers.index(header) + 1
            for header in required_headers
        }

        processed = []

        for row_number in range(
            2,
            ws.max_row + 1
        ):

            status = str(
                ws.cell(
                    row=row_number,
                    column=columns["Status"]
                ).value or ""
            ).strip().upper()

            # ONLY explicit PENDING rows are processed.
            if status != "PENDING":
                continue

            # --------------------------------------------------
            # CLAIM THE ROW IMMEDIATELY
            # --------------------------------------------------

            ws.cell(
                row=row_number,
                column=columns["Status"]
            ).value = "PROCESSING"

            workbook.save(
                CONTRIBUTIONS_FILE
            )

            # --------------------------------------------------
            # READ MEMBER
            # --------------------------------------------------

            member_id = str(
                ws.cell(
                    row=row_number,
                    column=columns["Member ID"]
                ).value or ""
            ).strip().upper()

            if not member_id:

                ws.cell(
                    row=row_number,
                    column=columns["Status"]
                ).value = (
                    "ERROR: Member ID required"
                )

                workbook.save(
                    CONTRIBUTIONS_FILE
                )

                continue

            member = get_member_details(
                member_id
            )

            if not member:

                ws.cell(
                    row=row_number,
                    column=columns["Status"]
                ).value = (
                    "ERROR: Member not found"
                )

                workbook.save(
                    CONTRIBUTIONS_FILE
                )

                continue

            # --------------------------------------------------
            # PAYMENT DATA
            # --------------------------------------------------

            amount = ws.cell(
                row=row_number,
                column=columns["Amount"]
            ).value

            payment_type = str(
                ws.cell(
                    row=row_number,
                    column=columns["Payment Type"]
                ).value or ""
            ).strip()

            description = str(
                ws.cell(
                    row=row_number,
                    column=columns["Description"]
                ).value or ""
            ).strip()

            payment_method = str(
                ws.cell(
                    row=row_number,
                    column=columns["Payment Method"]
                ).value or "M-PESA"
            ).strip()

            transaction_reference = str(
                ws.cell(
                    row=row_number,
                    column=columns["Transaction Reference"]
                ).value or ""
            ).strip()

            recorded_by = str(
                ws.cell(
                    row=row_number,
                    column=columns["Recorded By"]
                ).value or ""
            ).strip()

            payment_date = ws.cell(
                row=row_number,
                column=columns["Payment Date"]
            ).value

            payment_time = ws.cell(
                row=row_number,
                column=columns["Payment Time"]
            ).value

            # --------------------------------------------------
            # VALIDATION
            # --------------------------------------------------

            if not payment_type:

                ws.cell(
                    row=row_number,
                    column=columns["Status"]
                ).value = (
                    "ERROR: Payment type required"
                )

                workbook.save(
                    CONTRIBUTIONS_FILE
                )

                continue

            if amount is None:

                ws.cell(
                    row=row_number,
                    column=columns["Status"]
                ).value = (
                    "ERROR: Amount required"
                )

                workbook.save(
                    CONTRIBUTIONS_FILE
                )

                continue

            try:

                amount = float(amount)

                if amount <= 0:
                    raise ValueError

            except (TypeError, ValueError):

                ws.cell(
                    row=row_number,
                    column=columns["Status"]
                ).value = (
                    "ERROR: Invalid amount"
                )

                workbook.save(
                    CONTRIBUTIONS_FILE
                )

                continue

            # --------------------------------------------------
            # DEFAULT DATE/TIME
            # --------------------------------------------------

            now = datetime.now()

            if not payment_date:

                payment_date = now.strftime(
                    "%Y-%m-%d"
                )

            if not payment_time:

                payment_time = now.strftime(
                    "%H:%M:%S"
                )

            # --------------------------------------------------
            # GENERATE IDs
            # --------------------------------------------------

            receipt_number = (
                get_next_receipt_number()
            )

            contribution_id = (
                get_next_contribution_id(ws)
            )

            # --------------------------------------------------
            # GENERATE RECEIPT RECORD
            # --------------------------------------------------

            receipt = create_receipt(
                member_id=member["member_id"],
                member_name=member["full_name"],
                amount=amount,
                payment_type=payment_type,
                payment_reference=transaction_reference,
                description=description,
                receipt_number=receipt_number,
                payment_date=str(payment_date),
                phone_number=member["phone_number"],
                email=member["email"],
                payment_method=payment_method,
                recorded_by=recorded_by,
            )

            receipt["payment_time"] = str(
                payment_time
            )

            receipt["transaction_reference"] = (
                transaction_reference
            )

            # --------------------------------------------------
            # SAVE RECEIPT
            # --------------------------------------------------

            saved_receipt = add_receipt(
                receipt
            )

            # --------------------------------------------------
            # GENERATE EXACT PORTAL PDF
            # --------------------------------------------------

            pdf_bytes = (
                generate_receipt_pdf(
                    saved_receipt
                )
            )

            # --------------------------------------------------
            # EMAIL PDF
            # --------------------------------------------------

            member_email = str(
                member.get("email", "")
            ).strip()

            email_sent = False
            email_message = ""

            if member_email:

                email_sent, email_message = (
                    send_receipt_email(
                        recipient_email=member_email,
                        receipt_number=receipt_number,
                        member_name=member["full_name"],
                        amount=amount,
                        pdf_bytes=pdf_bytes,
                    )
                )

            else:

                email_message = (
                    "Member has no email address."
                )

            # --------------------------------------------------
            # COMPLETE THE SAME SPREADSHEET ROW
            # --------------------------------------------------

            ws.cell(
                row=row_number,
                column=columns["Contribution ID"]
            ).value = contribution_id

            ws.cell(
                row=row_number,
                column=columns["Receipt Number"]
            ).value = receipt_number

            ws.cell(
                row=row_number,
                column=columns["Full Name"]
            ).value = member["full_name"]

            ws.cell(
                row=row_number,
                column=columns["Phone Number"]
            ).value = member["phone_number"]

            ws.cell(
                row=row_number,
                column=columns["Email"]
            ).value = member["email"]

            ws.cell(
                row=row_number,
                column=columns["Payment Date"]
            ).value = payment_date

            ws.cell(
                row=row_number,
                column=columns["Payment Time"]
            ).value = payment_time

            ws.cell(
                row=row_number,
                column=columns["Status"]
            ).value = (
                "RECORDED - EMAIL QUEUED"
                if email_sent
                else "RECORDED - EMAIL FAILED"
            )

            ws.cell(
                row=row_number,
                column=columns["Created At"]
            ).value = (
                now.strftime(
                    "%Y-%m-%d %H:%M:%S"
                )
            )

            workbook.save(
                CONTRIBUTIONS_FILE
            )

            processed.append({
                "row": row_number,
                "contribution_id": contribution_id,
                "receipt_number": receipt_number,
                "email_sent": email_sent,
                "email_message": email_message,
            })

        return processed

    finally:

        lock.release()



