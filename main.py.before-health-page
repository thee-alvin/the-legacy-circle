@app.route("/api/forgot-password", methods=["POST"])
def forgot_password_api():

    data = request.get_json(silent=True) or {}

    member_id = str(data.get("member_id", "")).strip().upper()
    phone = str(data.get("phone", "")).strip()
    email = str(data.get("email", "")).strip().lower()

    if not member_id or not phone or not email:
        return jsonify({
            "success": False,
            "message": "Please provide your Membership ID, phone number and email."
        }), 400

    if not MEMBERS_FILE.exists():
        return jsonify({
            "success": False,
            "message": "TLC member records are unavailable."
        }), 500

    try:

        workbook = load_workbook(
            MEMBERS_FILE,
            read_only=True,
            data_only=True
        )

        sheet = workbook["Members"]

        rows = sheet.iter_rows(values_only=True)
        headers = next(rows)

        headers = [
            str(h).strip() if h is not None else ""
            for h in headers
        ]

        for row in rows:

            member = dict(zip(headers, row))

            stored_id = str(member.get("Member ID") or "").strip().upper()

            stored_phone = str(member.get("Phone Number") or "").strip()

            stored_email = str(
                member.get("Email Address") or ""
            ).strip().lower()

            # Normalize Kenyan phone numbers before comparison.
            def normalize_phone(value):
                digits = "".join(
                    ch for ch in str(value)
                    if ch.isdigit()
                )

                if digits.startswith("254"):
                    return "0" + digits[3:]

                if len(digits) == 9:
                    return "0" + digits

                return digits

            if (
                stored_id == member_id
                and normalize_phone(stored_phone) == normalize_phone(phone)
                and stored_email == email
            ):

                if not member.get("Password Hash"):
                    return jsonify({
                        "success": False,
                        "message": "This account has not been activated yet. Please use First Time Login."
                    }), 403

                return jsonify({
                    "success": True,
                    "message": "Account verified successfully."
                })

        return jsonify({
            "success": False,
            "message": "The details provided do not match our TLC records."
        }), 401

    except Exception:

        return jsonify({
            "success": False,
            "message": "Unable to verify your TLC account."
        }), 500

