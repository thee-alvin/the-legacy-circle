@app.route("/api/reset-password", methods=["POST"])
def reset_password_api():

    data = request.get_json(silent=True) or {}

    member_id = str(data.get("member_id", "")).strip().upper()
    password = str(data.get("password", ""))

    if not member_id or not password:
        return jsonify({
            "success": False,
            "message": "Member ID and new password are required."
        }), 400

    if len(password) < 8:
        return jsonify({
            "success": False,
            "message": "Password must be at least 8 characters."
        }), 400

    if not MEMBERS_FILE.exists():
        return jsonify({
            "success": False,
            "message": "TLC member records are unavailable."
        }), 500

    try:
        workbook = load_workbook(MEMBERS_FILE)
        sheet = workbook["Members"]

        headers = [
            str(cell.value).strip()
            if cell.value is not None
            else ""
            for cell in sheet[1]
        ]

        if "Member ID" not in headers or "Password Hash" not in headers:
            return jsonify({
                "success": False,
                "message": "Required password columns are missing."
            }), 500

        member_id_column = headers.index("Member ID") + 1
        password_column = headers.index("Password Hash") + 1

        for row_number in range(2, sheet.max_row + 1):

            stored_id = str(
                sheet.cell(
                    row=row_number,
                    column=member_id_column
                ).value or ""
            ).strip()

            if stored_id != member_id:
                continue

            new_hash = generate_password_hash(
                password,
                method="scrypt"
            )

            sheet.cell(
                row=row_number,
                column=password_column
            ).value = new_hash

            workbook.save(MEMBERS_FILE)

            return jsonify({
                "success": True,
                "message": "Password reset successfully."
            })

        return jsonify({
            "success": False,
            "message": "Member ID was not found."
        }), 404

    except PermissionError:
        return jsonify({
            "success": False,
            "message": "Please close the member spreadsheet and try again."
        }), 423

    except Exception:
        return jsonify({
            "success": False,
            "message": "Unable to reset the password."
        }), 500

