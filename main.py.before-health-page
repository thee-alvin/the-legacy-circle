@app.route("/api/login", methods=["POST"])
def member_login():

    data = request.get_json(silent=True) or {}

    member_id = str(data.get("member_id", "")).strip().upper()
    password = str(data.get("password", ""))

    if not member_id or not password:
        return jsonify({
            "success": False,
            "message": "Please enter your Member ID and password."
        }), 400

    if not MEMBERS_FILE.exists():
        return jsonify({
            "success": False,
            "message": "TLC member records are currently unavailable."
        }), 500

    try:

        workbook = load_workbook(
            MEMBERS_FILE,
            read_only=True,
            data_only=True
        )

        sheet = workbook["Members"]

        rows = sheet.iter_rows(values_only=True)
        headers = next(rows)

        headers = [
            str(header).strip()
            if header is not None
            else ""
            for header in headers
        ]

        for row in rows:

            member = dict(zip(headers, row))

            current_member_id = str(
                member.get("Member ID") or ""
            ).strip()

            if current_member_id != member_id:
                continue

            account_status = str(
                member.get("Account Status") or ""
            ).strip().lower()

            password_hash = member.get("Password Hash")

            if not password_hash:

                return jsonify({
                    "success": False,
                    "message": "Your account has not been activated yet. Please use First Time Login."
                }), 403

            if account_status != "active":

                return jsonify({
                    "success": False,
                    "message": "Your TLC account is not active."
                }), 403

            if check_password_hash(password_hash, password):

                start_member_session(
                    current_member_id,
                    role="MEMBER"
                )

                record_activity(
                    current_member_id,
                    action="Member Login",
                    description="Signed in to the TLC Member Portal.",
                    category="authentication"
                )

                return jsonify({
                    "success": True,
                    "message": "Login successful.",
                    "member": {
                        "member_id": current_member_id,
                        "name": str(
                            member.get("Full Name") or ""
                        )
                    }
                })

            break

        return jsonify({
            "success": False,
            "message": "Invalid Member ID or password."
        }), 401

    except Exception:
        return jsonify({
            "success": False,
            "message": "Unable to process the login."
        }), 500


