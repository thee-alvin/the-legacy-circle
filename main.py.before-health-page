@app.route("/api/verify-member", methods=["POST"])
def verify_member():

    data = request.get_json(silent=True) or {}

    member_id = str(data.get("member_id", "")).strip().upper()
    phone = str(data.get("phone", "")).strip()

    if not member_id or not phone:
        return jsonify({
            "success": False,
            "message": "Please enter your Member ID and registered phone number."
        }), 400

    if not MEMBERS_FILE.exists():
        return jsonify({
            "success": False,
            "message": "TLC member records are currently unavailable."
        }), 500

    try:

        workbook = load_workbook(
            MEMBERS_FILE,
            read_only=True,
            data_only=True
        )

        sheet = workbook["Members"]

        rows = sheet.iter_rows(values_only=True)
        headers = next(rows)

        headers = [
            str(header).strip() if header is not None else ""
            for header in headers
        ]

        required_columns = [
            "Member ID",
            "Full Name",
            "Phone Number",
            "Account Status"
        ]

        missing = [
            column
            for column in required_columns
            if column not in headers
        ]

        if missing:
            return jsonify({
                "success": False,
                "message": "TLC member spreadsheet is missing required columns."
            }), 500

        for row in rows:

            member = dict(zip(headers, row))

            spreadsheet_member_id = str(
                member.get("Member ID") or ""
            ).strip()

            spreadsheet_phone = str(
                member.get("Phone Number") or ""
            ).strip()

            if (
                spreadsheet_member_id == member_id
                and spreadsheet_phone == phone
            ):

                account_status = str(
                    member.get("Account Status") or ""
                ).strip().lower()

                if account_status not in ["active", "pending"]:
                    return jsonify({
                        "success": False,
                        "message": "This TLC membership is not eligible for account activation."
                    }), 403

                # Do not allow an account that already has a password
                # to enter the first-time activation process again.
                existing_password = member.get("Password Hash")

                if existing_password:
                    return jsonify({
                        "success": False,
                        "message": "This TLC account has already been activated. Please use Member Login."
                    }), 409

                return jsonify({
                    "success": True,
                    "message": "Member verified successfully.",
                    "member": {
                        "member_id": spreadsheet_member_id,
                        "name": str(member.get("Full Name") or "")
                    }
                })

        return jsonify({
            "success": False,
            "message": "The Member ID and phone number do not match our TLC records."
        }), 401

    except Exception:
        return jsonify({
            "success": False,
            "message": "Unable to verify the member record."
        }), 500


