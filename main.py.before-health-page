@app.route("/api/activate-account", methods=["POST"])
def activate_account():

    data = request.get_json(silent=True) or {}

    member_id = str(data.get("member_id", "")).strip().upper()
    password = str(data.get("password", ""))

    if not member_id or not password:
        return jsonify({
            "success": False,
            "message": "Member ID and password are required."
        }), 400

    if len(password) < 8:
        return jsonify({
            "success": False,
            "message": "Password must be at least 8 characters."
        }), 400

    if not MEMBERS_FILE.exists():
        return jsonify({
            "success": False,
            "message": "TLC member records are currently unavailable."
        }), 500

    try:

        # Open workbook normally because we need to modify it.
        workbook = load_workbook(MEMBERS_FILE)

        sheet = workbook["Members"]

        headers = [
            str(cell.value).strip()
            if cell.value is not None
            else ""
            for cell in sheet[1]
        ]

        required_columns = [
            "Member ID",
            "Password Hash",
            "Account Status"
        ]

        missing = [
            column
            for column in required_columns
            if column not in headers
        ]

        if missing:
            return jsonify({
                "success": False,
                "message": "TLC member spreadsheet is missing required columns."
            }), 500

        member_id_column = headers.index("Member ID") + 1
        password_column = headers.index("Password Hash") + 1
        status_column = headers.index("Account Status") + 1

        for row_number in range(2, sheet.max_row + 1):

            current_member_id = str(
                sheet.cell(
                    row=row_number,
                    column=member_id_column
                ).value or ""
            ).strip()

            if current_member_id != member_id:
                continue

            existing_hash = sheet.cell(
                row=row_number,
                column=password_column
            ).value

            if existing_hash:
                return jsonify({
                    "success": False,
                    "message": "This TLC account has already been activated. Please log in."
                }), 409

            account_status = str(
                sheet.cell(
                    row=row_number,
                    column=status_column
                ).value or ""
            ).strip().lower()

            if account_status not in ["active", "pending"]:
                return jsonify({
                    "success": False,
                    "message": "This member account is not eligible for activation."
                }), 403

            # Never store the actual password.
            password_hash = generate_password_hash(
                password,
                method="scrypt"
            )

            sheet.cell(
                row=row_number,
                column=password_column
            ).value = password_hash

            # The account is now activated.
            sheet.cell(
                row=row_number,
                column=status_column
            ).value = "active"

            workbook.save(MEMBERS_FILE)

            return jsonify({
                "success": True,
                "message": "TLC account activated successfully."
            })

        return jsonify({
            "success": False,
            "message": "Member ID was not found."
        }), 404

    except PermissionError:
        return jsonify({
            "success": False,
            "message": "The member spreadsheet is currently open. Please close it and try again."
        }), 423

    except Exception:
        return jsonify({
            "success": False,
            "message": "Unable to activate the TLC account."
        }), 500


